# Nginx 站点配置示例（宝塔面板：网站 → 设置 → 配置文件）
# 将 server_name 替换为你的域名，root 替换为实际部署路径

server {
    listen 80;
    listen [::]:80;
    server_name aistock.你的域名.com;

    root /www/wwwroot/aistocklink/dist;
    index index.html;

    # SPA 路由回退（Vue Router history 模式）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 业务 API → 本地 Node 服务（serve.mjs，端口 4173）
    location /api/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Kronos AI 预测（长任务，超时放宽）
    location /kronos/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpe?g|svg|gif|webp|woff2?|ico|ttf)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # 安全响应头（可选）
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;

    # gzip 压缩
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1k;
}

# HTTPS 由宝塔面板 Let's Encrypt 自动生成 443 配置并开启 301 跳转
